NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# First platform-console user bootstrap.
# Set these before first /platform/login. After one platform user exists, these
# credentials no longer create users.
PLATFORM_BOOTSTRAP_EMAIL=
PLATFORM_BOOTSTRAP_PASSWORD=
PLATFORM_BOOTSTRAP_NAME=Retivox Developer

# Safaricom M-PESA Express / STK Push sandbox.
# Server-only. Do not prefix these with NEXT_PUBLIC_.
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Optional when NEXT_PUBLIC_APP_URL or VERCEL_URL points to the deployed app.
MPESA_CALLBACK_URL=https://your-public-https-domain.com/api/daraja/stk-callback
MPESA_TEST_PHONE=254115157312
