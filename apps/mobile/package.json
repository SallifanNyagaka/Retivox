{
  "_comment": "This is the SmartRetail mobile POS app for employees, admins and owners",
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:clear": "expo start -c --lan",
    "dev-client": "expo start --dev-client",
    "dev-client:lan": "expo start --dev-client --lan",
    "dev-client:tunnel": "expo start --dev-client --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@nozbe/watermelondb": "^0.27.1",
    "@nozbe/with-observables": "^1.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.10",
    "@react-navigation/native-stack": "^6.9.18",
    "@smartretail/shared": "workspace:*",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.17.19",
    "date-fns": "^3.3.1",
    "expo": "~54.0.36",
    "expo-barcode-scanner": "~13.0.1",
    "expo-camera": "~17.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-network": "~8.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "0.359.0",
    "nativewind": "^4.0.36",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb",
          "@nozbe/simdjson",
          "expo-barcode-scanner"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true
